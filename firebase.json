{
  "functions": [{ "source": "functions", "codebase": "default" }],
  "hosting": [
    {
      "target": "app",
      "public": ".",
      "ignore": ["firebase.json", ".firebaserc", ".firebase/**", ".git/**", "**/node_modules/**", "functions/**", "*.md", "**/*.keystore", "**/*.apk", "**/*.aab", "signing-key-info.txt"],
      "rewrites": [{ "source": "/zel-app.html", "destination": "/index.html" }],
      "headers": [
        { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
        { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "**/*.@(css|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "target": "zel",
      "public": ".",
      "ignore": ["firebase.json", ".firebaserc", ".firebase/**", ".git/**", "**/node_modules/**", "functions/**", "*.md", "**/*.keystore", "**/*.apk", "**/*.aab", "signing-key-info.txt"],
      "rewrites": [{ "source": "/zel-app.html", "destination": "/index.html" }],
      "headers": [
        { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
        { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "**/*.@(css|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    }
  ]
}
